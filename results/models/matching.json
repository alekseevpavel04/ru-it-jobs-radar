  "definitions": {
    "pool": "IT dedup entities of trudvsem, Habr Career and SuperJob whose latest record has valid fields of the extraction model with a role other than non_it; text is the extractor input of that record.",
    "queries": "Synthetic resumes rendered by templates from the extracted fields of a seed vacancy (role title, grade, experience, 60-100% of its skills plus up to 2 common skills of the role, city, remote); seeds with at least 3 skills, split dev/test by a salted hash of the entity id.",
    "relevance": "2: same role bucket, grade within one step, place fits and the resume covers at least half of the vacancy's extracted skills; 1: the same without the skill condition; 0 otherwise.",
    "ndcg": "nDCG@10 with gains 2^rel - 1 against the ideal ranking of the whole pool.",
    "mrr": "Reciprocal rank of the first vacancy with relevance 2.",
    "recall": "Vacancies with relevance 2 in the top 50 divided by min(their number, 50).",
    "ci": "Percentile bootstrap over resumes, resamples and seed in configs/eval.toml; differences paired."
  },
  "limits_ru": [
    "Резюме синтетические: шаблон из полей вакансии, короткий и перечисляющий навыки. Настоящие резюме длиннее и написаны свободным текстом, на них лексический поиск теряет преимущество совпадения слов.",

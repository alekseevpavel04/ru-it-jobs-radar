  "definitions": {
    "target": "Midpoint of the stated range in RUB per month; a single stated bound stands for itself. Amounts as the source states them: no period or gross/net field exists in trudvsem or Habr Career.",
    "population": "IT dedup entities (rule role bucket not not_it) of trudvsem and Habr Career with a RUB salary, latest record of each entity, part-time vacancies left out.",
    "split": "Connected components over entity, dedup text cluster, extraction-corpus group and employer with one normalized title lie in one split; corpus gold test and dev groups pinned; calib is part of train.",
    "mae_rub": "Mean absolute error of the point against the midpoint, RUB per month.",
    "mape": "Mean of |point - midpoint| / midpoint.",
    "within_20pct": "Share of vacancies whose point is within 20% of the midpoint.",
    "coverage": "Share of vacancies whose midpoint lies in [low, high].",
    "width_rub": "Mean high - low, RUB per month.",
    "width_rel": "Mean (high - low) / point.",
    "ci": "Percentile bootstrap over dev groups (whole components), resamples and seed in configs/eval.toml; differences are paired on the same resamples.",
    "importance": "Rise of dev MAE of the boosting point when the columns of one input are shuffled across dev rows; shuffling breaks correlated inputs together only within a block."
  },
  "limits_ru": [
    "Признаки v0 взяты из правил витрин (роль по заголовку, грейд по заголовку, навыки по словарю), а не из извлечения студентом; после разметки всего корпуса студентом модель переобучается на извлечённых полях.",
    "Gross или net источники не указывают, суммы взяты как опубликованы; источник стоит признаком.",
    "Почти все строки из trudvsem (портал «Работа России»), Хабр Карьера даёт десятки вакансий: оценка для source=habr опирается на малую выборку.",
    "Цель это середина опубликованной вилки; вилка «от X» без верхней границы считается как X."
  ],

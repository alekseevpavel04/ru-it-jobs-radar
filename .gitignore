# secrets
.env
.env.*
!.env.example
*.session
*.pem

# tooling
.venv/
__pycache__/
*.pyc
node_modules/
logs/
.vscode/
.DS_Store

# data stays local; only DVC pointers (data/*.dvc) are versioned, the remote lives in storage/.
# "?*" instead of "*": DVC's ignore check treats "/data/*" as ignoring data/ itself and never finds the pointers.
/data/?*
!/data/*.dvc
/models/
mlruns/
mlartifacts/
storage/
*.gguf
*.safetensors

# training run caches
unsloth_compiled_cache/

# dbt build artifacts
dbt/target/
dbt/logs/
dbt/dbt_packages/

# site build outputs; site/src/data (the export) is versioned
/site/dist/
/site/src/.observablehq/cache/
/site/_trial/

      "title": "Запросы ClickHouse в секунду",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "rate(ClickHouseProfileEvents_SelectQuery_total[5m])",
          "legendFormat": "SELECT"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "rate(ClickHouseProfileEvents_InsertQuery_total[5m])",
          "legendFormat": "INSERT"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "rate(ClickHouseProfileEvents_FailedQuery_total[5m])",

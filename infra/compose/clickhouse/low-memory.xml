<clickhouse>
    <!-- The server shares a 20 GB WSL VM with Redpanda, Airflow and model training; the default
         5 GB mark cache is sized for a dedicated host. -->
    <mark_cache_size>268435456</mark_cache_size>
    <index_mark_cache_size>134217728</index_mark_cache_size>

    <!-- Profiling logs grow every second and nothing in the project reads them. query_log and
         part_log stay: they answer what the agent ran and how ingestion behaves. -->
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <query_metric_log remove="1"/>
    <latency_log remove="1"/>
    <processors_profile_log remove="1"/>
</clickhouse>

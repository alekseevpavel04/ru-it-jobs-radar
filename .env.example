# Copy to .env and fill in. Required variables stop the run with a clear message when empty.

# Where the raw layer and derived data live; relative paths resolve from the repo root.
RADAR_DATA_DIR=data
# Sent with every request to sources; keep a contact link so a site owner can reach the project.
RADAR_USER_AGENT=ru-it-jobs-radar/0.1 (+https://github.com/alekseevpavel04/ru-it-jobs-radar)

# ClickHouse over HTTP, e.g. http://localhost:8123
CLICKHOUSE_URL=http://localhost:8123
# Read-only user the analyst agent connects with (no INSERT, ALTER, DROP on the server side).
CLICKHOUSE_RO_USER=
# Redpanda bootstrap servers, e.g. localhost:19092
REDPANDA_BROKERS=localhost:19092
# Redis for the API cache, e.g. redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
# OpenAI-compatible endpoint of llama-server or vLLM, e.g. http://localhost:8080/v1
LLM_BASE_URL=http://localhost:8080/v1
# MLflow tracking server, e.g. http://localhost:5000
MLFLOW_TRACKING_URI=http://localhost:5000
# Optional: SuperJob application secret key; the SuperJob collector is skipped without it.
SUPERJOB_APP_KEY=

# Local stack (infra/compose, started by scripts/up.sh). Ports listen on 127.0.0.1 only.
# ClickHouse account with full rights: collectors, the Redpanda consumer and dbt write with it.
CLICKHOUSE_USER=radar
# Password of CLICKHOUSE_USER.
CLICKHOUSE_PASSWORD=
# Password of CLICKHOUSE_RO_USER; letters, digits and _.~+/=- only.
CLICKHOUSE_RO_PASSWORD=
# Password of the Postgres behind MLflow; letters and digits only, it goes into a connection URI.
MLFLOW_DB_PASSWORD=

# Airflow (profile orchestration; scripts/up.sh stops when one of these is empty). UI on
# http://localhost:8090, account admin.
# Password of the Postgres behind Airflow; letters and digits only, it goes into a connection URI.
AIRFLOW_DB_PASSWORD=
# Password of the Airflow account admin.
AIRFLOW_ADMIN_PASSWORD=
# Secret that signs the tokens of Airflow tasks; any long random string, e.g. `openssl rand -hex 32`.
AIRFLOW_JWT_SECRET=

# n8n (profile mlops; scripts/up.sh and scripts/n8n_import.sh stop when it is empty). UI on
# http://localhost:5678, account owner@radar.local, created by scripts/n8n_import.sh. 8 to 64
# characters with a digit and an uppercase letter (n8n's rule); letters, digits and _.~+/=- only.
N8N_OWNER_PASSWORD=

# Superset (profile bi; scripts/up.sh and scripts/superset_import.sh stop when one of these is empty).
# UI on http://localhost:8088, account admin. It reads ClickHouse as CLICKHOUSE_RO_USER (marts only).
# Signs the session cookies and encrypts the stored ClickHouse password; any long random string,
# e.g. `openssl rand -base64 42`. After a change rerun scripts/superset_import.sh.
SUPERSET_SECRET_KEY=
# Password of the Superset account admin.
SUPERSET_ADMIN_PASSWORD=
# API (python -m radar.api): the student's llama-server root without /v1; empty means the regex backend
STUDENT_LLM_URL=
# adapter directory whose dataset_meta.json gives the student prompt; default data/sft/meta.json
STUDENT_ADAPTER_DIR=
STUDENT_TIMEOUT_S=60
API_STATS_TTL_S=3600
API_EXTRACT_TTL_S=86400

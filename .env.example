# Copy to .env and fill in. Required variables stop the run with a clear message when empty.

# Where the raw layer and derived data live; relative paths resolve from the repo root.
RADAR_DATA_DIR=data
# Sent with every request to sources; keep a contact link so a site owner can reach the project.
RADAR_USER_AGENT=ru-it-jobs-radar/0.1 (+https://github.com/alekseevpavel04/ru-it-jobs-radar)

# ClickHouse over HTTP, e.g. http://localhost:8123
CLICKHOUSE_URL=
# Read-only user the analyst agent connects with (no INSERT, ALTER, DROP on the server side).
CLICKHOUSE_RO_USER=
# Redpanda bootstrap servers, e.g. localhost:19092
REDPANDA_BROKERS=
# Redis for the API cache, e.g. redis://localhost:6379/0
REDIS_URL=
# OpenAI-compatible endpoint of llama-server or vLLM, e.g. http://localhost:8080/v1
LLM_BASE_URL=
# MLflow tracking server, e.g. http://localhost:5000
MLFLOW_TRACKING_URI=
# Optional: SuperJob application secret key; the SuperJob collector is skipped without it.
SUPERJOB_APP_KEY=
